<UserControl x:Class="RelevPro.Views.Releves.ReadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{Binding ViewName}" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="{Binding ViewSubtitle}" Style="{StaticResource SectionText}" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="Saisie">
                <DockPanel Margin="0,12,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button Content="◀" Style="{StaticResource SecondaryButton}" Command="{Binding PreviousPeriodCommand}" Margin="0,0,6,0" Padding="10,3"/>
                        <TextBlock Text="{Binding PeriodTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="170" TextAlignment="Center"/>
                        <Button Content="▶" Style="{StaticResource SecondaryButton}" Command="{Binding NextPeriodCommand}" Margin="6,0,12,0" Padding="10,3"/>
                        <DatePicker SelectedDate="{Binding RefDate}" Width="130" Margin="0,0,8,0"/>
                        <Button Content="Aujourd'hui" Style="{StaticResource SecondaryButton}" Command="{Binding TodayCommand}" Margin="0,0,24,0"/>
                        <Button Content="+ Compteur" Style="{StaticResource PrimaryButton}" Command="{Binding AddMeterLineCommand}" Margin="0,0,8,0" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="+ Tâche" Style="{StaticResource PrimaryButton}" Command="{Binding AddTaskLineCommand}" Margin="0,0,24,0" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="{Binding EditModeButtonLabel}" Command="{Binding ToggleEditModeCommand}" Style="{StaticResource EditModeButtonStyle}" Padding="12,5"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="{StaticResource BrushPrimary}" TextWrapping="Wrap"/>
                    <!-- Colonnes de saisie (une par semaine / période) ajoutées dans ReadingView.xaml.cs, entre « Récurrence » et « Consommation ». -->
                    <DataGrid x:Name="SaisieGrid" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" RowHeight="34" GridLinesVisibility="All">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Section" Binding="{Binding Groupe}" IsReadOnly="True" Width="140"/>
                            <DataGridTextColumn Header="Ligne" Binding="{Binding Title}" IsReadOnly="True" Width="*" MinWidth="170"/>
                            <DataGridTextColumn Header="Récurrence" Binding="{Binding RecurrenceName}" IsReadOnly="True" Width="105"/>
                            <DataGridTextColumn x:Name="ConsumptionColumn" Header="Consommation" Binding="{Binding ConsumptionText}" IsReadOnly="True" Width="130"/>
                            <DataGridTemplateColumn Header="Statut" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                            <Button Content="Modifier" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0" Command="{Binding EditCommand}"/>
                                            <Button Content="Retirer" Style="{StaticResource DangerButton}" Padding="8,3" Command="{Binding DeleteCommand}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Consommation par mois">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Année :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" Width="100"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding MonthlyTable}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Consommation par an">
                <DockPanel Margin="0,12,0,0">
                    <DataGrid ItemsSource="{Binding YearlyTable}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Relevés">
                <DockPanel Margin="0,12,0,0">
                    <DataGrid ItemsSource="{Binding Readings}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="100"/>
                            <DataGridTextColumn Header="Compteur" Binding="{Binding Meter}" Width="*"/>
                            <DataGridTextColumn Header="Valeur" Binding="{Binding ValueText}" Width="110"/>
                            <DataGridTextColumn Header="Unité" Binding="{Binding Unit}" Width="70"/>
                            <DataGridTextColumn Header="Forcé" Binding="{Binding ForcedText}" Width="70"/>
                            <DataGridTextColumn Header="Anomalie" Binding="{Binding Anomaly}" Width="2*"/>
                            <DataGridTextColumn Header="Saisi par" Binding="{Binding By}" Width="110"/>
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Supprimer" Style="{StaticResource DangerButton}" Padding="8,3" Visibility="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.DeleteReadingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
