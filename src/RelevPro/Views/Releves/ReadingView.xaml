<UserControl x:Class="RelevPro.Views.Releves.ReadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{Binding ViewName}" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Saisie des relevés et des tâches, récapitulatifs de consommation." Style="{StaticResource SectionText}" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="Saisie">
                <DockPanel Margin="0,12,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Date de saisie :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding RefDate}" Width="140" Margin="0,0,8,0"/>
                        <Button Content="Aujourd'hui" Style="{StaticResource SecondaryButton}" Command="{Binding TodayCommand}" Margin="0,0,24,0"/>
                        <Button Content="+ Compteur" Style="{StaticResource PrimaryButton}" Command="{Binding AddMeterLineCommand}" Margin="0,0,8,0"/>
                        <Button Content="+ Tâche" Style="{StaticResource PrimaryButton}" Command="{Binding AddTaskLineCommand}"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="{StaticResource BrushPrimary}" TextWrapping="Wrap"/>
                    <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" RowHeight="36" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding KindIcon}" IsReadOnly="True" Width="32"/>
                            <DataGridTextColumn Header="Ligne" Binding="{Binding Title}" IsReadOnly="True" Width="*" MinWidth="160"/>
                            <DataGridTextColumn Header="Récurrence" Binding="{Binding RecurrenceName}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="Période" Binding="{Binding PeriodLabel}" IsReadOnly="True" Width="190"/>
                            <DataGridTextColumn Header="Dernier relevé / réalisation" Binding="{Binding LastText}" IsReadOnly="True" Width="220"/>
                            <DataGridTemplateColumn Header="Saisie" Width="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsMeter, Converter={StaticResource BoolToVis}}">
                                                <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" Width="110" VerticalContentAlignment="Center" Margin="4,0">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Return" Command="{Binding SaveCommand}"/>
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                                <TextBlock Text="{Binding Unit}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" Padding="8,3" Command="{Binding SaveCommand}"/>
                                            </StackPanel>
                                            <CheckBox Content="Fait" IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0"
                                                      Visibility="{Binding IsTask, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Statut" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Modifier" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0" Command="{Binding EditCommand}"/>
                                            <Button Content="Retirer" Style="{StaticResource DangerButton}" Padding="8,3" Command="{Binding DeleteCommand}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Consommation par mois">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Année :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" Width="100"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding MonthlyTable}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Consommation par an">
                <DockPanel Margin="0,12,0,0">
                    <DataGrid ItemsSource="{Binding YearlyTable}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Relevés">
                <DockPanel Margin="0,12,0,0">
                    <DataGrid ItemsSource="{Binding Readings}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="100"/>
                            <DataGridTextColumn Header="Compteur" Binding="{Binding Meter}" Width="*"/>
                            <DataGridTextColumn Header="Valeur" Binding="{Binding ValueText}" Width="110"/>
                            <DataGridTextColumn Header="Unité" Binding="{Binding Unit}" Width="70"/>
                            <DataGridTextColumn Header="Forcé" Binding="{Binding ForcedText}" Width="70"/>
                            <DataGridTextColumn Header="Anomalie" Binding="{Binding Anomaly}" Width="2*"/>
                            <DataGridTextColumn Header="Saisi par" Binding="{Binding By}" Width="110"/>
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Supprimer" Style="{StaticResource DangerButton}" Padding="8,3"
                                                Command="{Binding DataContext.DeleteReadingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
