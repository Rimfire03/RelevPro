<UserControl x:Class="RelevPro.Views.Releves.ReadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{Binding ViewName}" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="{Binding ViewSubtitle}" Style="{StaticResource SectionText}" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="Saisie">
                <DockPanel Margin="0,12,0,0">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button Content="◀" Style="{StaticResource SecondaryButton}" Command="{Binding PreviousPeriodCommand}" Margin="0,0,6,0" Padding="10,3"/>
                        <TextBlock Text="{Binding PeriodTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="170" TextAlignment="Center"/>
                        <Button Content="▶" Style="{StaticResource SecondaryButton}" Command="{Binding NextPeriodCommand}" Margin="6,0,12,0" Padding="10,3"/>
                        <DatePicker SelectedDate="{Binding RefDate}" Width="130" Margin="0,0,8,0"/>
                        <Button Content="Aujourd'hui" Style="{StaticResource SecondaryButton}" Command="{Binding TodayCommand}" Margin="0,0,24,0"/>
                        <Button Content="+ Compteur" Style="{StaticResource PrimaryButton}" Command="{Binding AddMeterLineCommand}" Margin="0,0,8,0" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="+ Tâche" Style="{StaticResource PrimaryButton}" Command="{Binding AddTaskLineCommand}" Margin="0,0,8,0" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Modifier la ligne" Style="{StaticResource SecondaryButton}" Command="{Binding EditSelectedCommand}" Margin="0,0,8,0" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Supprimer la ligne" Style="{StaticResource DangerButton}" Command="{Binding DeleteSelectedCommand}" Margin="0,0,8,0" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Unités…" Style="{StaticResource SecondaryButton}" Command="{Binding ManageUnitsCommand}" Margin="0,0,8,0" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Familles…" Style="{StaticResource SecondaryButton}" Command="{Binding ManageFamiliesCommand}" Margin="0,0,24,0" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="{Binding EditModeButtonLabel}" Command="{Binding ToggleEditModeCommand}" Style="{StaticResource EditModeButtonStyle}" Padding="12,5" Margin="0,0,16,0"/>
                        <CheckBox Content="Afficher les compteurs arrêtés" IsChecked="{Binding ShowStopped}" VerticalAlignment="Center"
                                  Visibility="{Binding HasStopped, Converter={StaticResource BoolToVis}}"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Margin="0,8,0,0" Foreground="{StaticResource BrushPrimary}" TextWrapping="Wrap"/>
                    <!-- Colonnes de saisie (une par semaine / période) ajoutées dans ReadingView.xaml.cs, entre « Récurrence » et « Consommation ». -->
                    <DataGrid x:Name="SaisieGrid" ItemsSource="{Binding Lines}" CanUserResizeColumns="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectedItem="{Binding SelectedLine, Mode=TwoWay}" HeadersVisibility="Column" SelectionMode="Single" RowHeight="34" GridLinesVisibility="Vertical">
                        <!-- Traits horizontaux dessinés par les cellules (bas de cellule) pour pouvoir les retirer dans la colonne Section : cellules fusionnées. -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="BorderBrush" Value="{Binding HorizontalGridLinesBrush, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Style.Triggers>
                                    <!-- trait plus épais à chaque changement de section (dernière ligne du bloc) -->
                                    <DataTrigger Binding="{Binding IsGroupEnd}" Value="True"><Setter Property="BorderThickness" Value="0,0,1,3"/><Setter Property="BorderBrush" Value="#94A3B8"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Section" Binding="{Binding GroupeShown}" IsReadOnly="True" Width="190" MinWidth="80">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="BorderBrush" Value="{Binding HorizontalGridLinesBrush, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGroupEnd}" Value="True"><Setter Property="BorderThickness" Value="0,0,1,3"/><Setter Property="BorderBrush" Value="#94A3B8"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="{Binding GroupeAlign}"/><Setter Property="Margin" Value="4,0,0,2"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ligne" Binding="{Binding Title}" IsReadOnly="True" Width="300" MinWidth="120"/>
                            <DataGridTextColumn Header="Récurrence" Binding="{Binding RecurrenceName}" IsReadOnly="True" Width="105"/>
                            <DataGridTextColumn x:Name="ConsumptionColumn" Header="Consommation" Binding="{Binding ConsumptionText}" IsReadOnly="True" Width="130"/>
                            <DataGridTemplateColumn Header="Statut" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Consommation par mois">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Année :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" Width="100"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding MonthlyTable}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Consommation par an">
                <DockPanel Margin="0,12,0,0">
                    <DataGrid ItemsSource="{Binding YearlyTable}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Statistiques">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Année :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" Width="100"/>
                        <TextBlock Text="Consommation et écart N-1 : de janvier à aujourd'hui pour l'année en cours ; tâches : périodes échues." Style="{StaticResource SectionText}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding StatsTable}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
