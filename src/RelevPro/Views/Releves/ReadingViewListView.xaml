<UserControl x:Class="RelevPro.Views.Releves.ReadingViewListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Vues de relevé" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Chaque vue regroupe des compteurs à relever et des tâches à cocher. Ouvrez-la pour saisir." Style="{StaticResource SectionText}" Margin="0,4,0,10"/>
            <Button Content="+ Nouvelle vue" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="36">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Vue" Binding="{Binding Nom}" Width="*"/>
                <DataGridTextColumn Header="Contenu" Binding="{Binding Summary}" Width="260"/>
                <DataGridTemplateColumn Width="280">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Ouvrir" Style="{StaticResource PrimaryButton}" Padding="8,3" Margin="0,0,6,0"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Content="Renommer" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0"
                                        Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                <Button Content="Supprimer" Style="{StaticResource DangerButton}" Padding="8,3"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
