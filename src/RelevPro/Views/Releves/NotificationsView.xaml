<UserControl x:Class="RelevPro.Views.Releves.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Notifications" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource SectionText}" Margin="0,4,0,0"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="36">
            <DataGrid.Columns>
                <DataGridTextColumn Header="" Binding="{Binding Icon}" Width="36"/>
                <DataGridTextColumn Header="Notification" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Détail" Binding="{Binding Detail}" Width="2*"/>
                <DataGridTextColumn Header="Vue" Binding="{Binding ViewName}" Width="160"/>
                <DataGridTemplateColumn Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Ouvrir" Style="{StaticResource PrimaryButton}" Padding="8,3"
                                    Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
