  </ItemGroup>

  <ItemGroup>
    <!-- Contrat de licence utilisateur final, intÃ©grÃ© Ã  l'exÃ©cutable : volontairement PAS copiÃ© dans
         RelevData\, puisque RelevData\CLUF.txt n'y est Ã©crit qu'Ã  l'acceptation du contrat au premier
         lancement (voir App.Eula.cs). -->
